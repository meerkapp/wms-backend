### APP ###
APP_PORT=3000

### DATABASE ###
# For meerk-postgres and meerk-wms Docker containers
POSTGRES_USER=meerk
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=meerk-postgres
POSTGRES_PORT=5432
POSTGRES_DB=meerk_db

### REDIS ###
REDIS_HOST=meerk-redis
REDIS_PORT=6379
REDIS_DB=0

# E2E tests must never use the development database or Redis DB.
# When omitted locally, TEST_DATABASE_URL defaults to DATABASE_URL with a _test suffix.
# TEST_DATABASE_URL=postgresql://meerk:change_me@localhost:5432/meerk_db_test
TEST_REDIS_DB=15

### S3 / MINIO ###
S3_ENDPOINT=http://meerk-minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me
S3_BUCKET=meerk

### JWT ###
JWT_ACCESS_SECRET=change_me
# Temporary compatibility for migrating pre-0.3 refresh cookies.
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=15m

### CORS ###
# Exact frontend origin is required because authentication uses credentials.
FRONT_END_DOMAIN=http://localhost:5173
COOKIE_SECURE=true

### DOCS ###
IS_DOCS_ENABLED=false
SCALAR_PATH=/docs

### DATABASE [DEV] ###
# For Prisma
# Format: postgresql://{user}:{password}@{host}:{port}/{database}
# DATABASE_URL=postgresql://meerk:change_me@meerk-postgres:5432/meerk_db
